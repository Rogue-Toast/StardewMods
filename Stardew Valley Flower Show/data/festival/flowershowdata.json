{
    "Changes": [
        {
            "LogName": "Stardew Valley Flower Show",
            "Action": "EditData",
            "Target": "Data/PassiveFestivals",
            "Entries": {
                "{{ModId}}_FlowerShow": {
                    "DisplayName": "{{i18n:SVFS.FlowerShow.name}}",
                    "Season": "Summer",
                    "StartDay": "6",
                    "EndDay": "7",
                    "StartTime": "1000",
                    "StartMessage": "{{i18n:SVFS.StartShow}}",
                    "ShowOnCalendar": true
                }
            },    
            "When": {
                "HasReadLetter: anyPlayer |contains=SVFS.Invitation": true
            }
        },
        {
            "LogName": "Festival weather",
            "Action": "EditData",
            "Target": "Data/TriggerActions",
            "Entries": {
                "{{ModId}}_SVFSWeather": {
                    "Id": "{{ModId}}_SVFSWeather",
                    "Trigger": "DayStarted",
                    "Condition": "SEASON_DAY summer 5 summer 6",
                    "Action": "Spiderbuttons.BETAS_WeatherForTomorrow Default Sun",
                    "MarkActionApplied": false
                }
            }
        },
