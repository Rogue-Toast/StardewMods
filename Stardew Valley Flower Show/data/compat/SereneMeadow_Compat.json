		{
			"LogName": "Edit flowershop inventory - Serene Meadow Compat",
			"Action": "EditData",
			"Target": "Data/Shops",
			"TargetField": [ "SVFS_FlowerShop", "Items"],
			"When": {
            	"HasMod |contains=Lumisteria.SereneMeadow": true,
            	},
        	"Entries": {
